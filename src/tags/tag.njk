---
pagination:
  data: tags
  size: 1
  alias: tag
layout: layouts/page.njk
---
{% if tag.commentary %}
<p>{{ tag.commentary }}</p>
{% endif %}

<p>{{ tag.count }} post{% if tag.count != 1 %}s{% endif %} tagged <code>{{ tag.displayTitle }}</code>.</p>

{% set posts = tag.posts %}
{% include "partials/post-list.njk" %}
