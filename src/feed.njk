---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xmlEscape }}</title>
    <description>{{ site.description | striptags | xmlEscape }}</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <pubDate>{% currentDateRfc822 %}</pubDate>
    <lastBuildDate>{% currentDateRfc822 %}</lastBuildDate>
    <generator>Eleventy</generator>
    {% for post in posts %}
      {% if loop.index0 < 10 %}
      <item>
        <title>{{ post.title | xmlEscape }}</title>
        <description>{{ post.absoluteContent | xmlEscape }}</description>
        <pubDate>{{ post.date | rfc822Date }}</pubDate>
        <link>{{ site.url }}{{ post.permalink }}</link>
        <guid isPermaLink="true">{{ site.url }}{{ post.permalink }}</guid>
        {% for tag in post.tags %}
        <category>{{ tag | xmlEscape }}</category>
        {% endfor %}
      </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
